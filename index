      --line:#d9d8cf; --accent:#c8553d; --accent-strong:#9f3827; --accent-soft:#f3d8cf;
      --teal:#195e57; --teal-soft:#d9e8e3; --gold:#d2a43b; --shadow:0 18px 55px rgba(32,40,36,.10);
      --success:#176845; --danger:#a23c2c; --focus:#167a70;
    }
    @media (prefers-color-scheme: dark) {
      :root { --bg:#111815; --paper:#19211e; --ink:#f4f1e8; --muted:#aeb9b4; --line:#37413d; --accent:#ef765b; --accent-strong:#ff967f; --accent-soft:#502e27; --teal:#7ec0b5; --teal-soft:#263c37; --gold:#e2b957; --shadow:0 20px 60px rgba(0,0,0,.28); --success:#69c796; --danger:#ff8e78; --focus:#86d7cb; }
    }
    [data-theme="light"] { color-scheme:light; --bg:#f3f0e9; --paper:#fffdf8; --ink:#18231f; --muted:#65706b; --line:#d9d8cf; --accent:#c8553d; --accent-strong:#9f3827; --accent-soft:#f3d8cf; --teal:#195e57; --teal-soft:#d9e8e3; --gold:#d2a43b; --shadow:0 18px 55px rgba(32,40,36,.10); --success:#176845; --danger:#a23c2c; --focus:#167a70; }
    [data-theme="dark"] { color-scheme:dark; --bg:#111815; --paper:#19211e; --ink:#f4f1e8; --muted:#aeb9b4; --line:#37413d; --accent:#ef765b; --accent-strong:#ff967f; --accent-soft:#502e27; --teal:#7ec0b5; --teal-soft:#263c37; --gold:#e2b957; --shadow:0 20px 60px rgba(0,0,0,.28); --success:#69c796; --danger:#ff8e78; --focus:#86d7cb; }

    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",sans-serif;min-height:100vh}
    button,input{font:inherit} button{color:inherit} a{color:inherit}
    .skip{position:fixed;top:-80px;left:18px;background:var(--ink);color:var(--paper);padding:10px 14px;z-index:20}.skip:focus{top:18px}
    .shell{width:min(1180px,100%);margin:auto;padding:24px clamp(18px,4vw,48px) 48px}
    .utility{display:flex;align-items:center;justify-content:flex-end;margin-bottom:18px}
    .icon-btn{width:42px;height:42px;border:1px solid var(--line);background:var(--paper);display:grid;place-items:center;border-radius:50%;cursor:pointer;transition:border-color .2s,background .2s}.icon-btn:hover{border-color:var(--teal);background:var(--teal-soft)}
    .icon-btn svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8}
    .layout{display:grid;grid-template-columns:300px minmax(0,1fr);gap:22px;align-items:start}
    .panel{background:var(--paper);border:1px solid var(--line);box-shadow:var(--shadow)}
    aside{padding:28px;position:sticky;top:22px}
    .brand{display:block;margin:0 0 24px}.brand img{display:block;width:100%;height:auto}
    .eyebrow{font-size:.73rem;letter-spacing:.16em;text-transform:uppercase;color:var(--teal);font-weight:700;margin:0 0 12px}
    h1,h2,h3,p{margin-top:0} h1,h2{font-family:"Newsreader",serif} h1{font-size:clamp(2.1rem,4vw,3.55rem);line-height:.97;letter-spacing:-.035em;margin-bottom:16px;max-width:650px} h2{font-size:2rem;letter-spacing:-.025em;margin-bottom:10px} h3{font-size:1rem;margin-bottom:7px}
    .intro{color:var(--muted);line-height:1.65;margin-bottom:25px}
    .nav{display:grid;gap:8px;margin:22px 0}.nav button{border:0;background:transparent;text-align:left;padding:12px 13px;cursor:pointer;color:var(--muted);display:flex;align-items:center;gap:11px;border-radius:7px}.nav button:hover{background:var(--teal-soft);color:var(--ink)}.nav button.active{background:var(--teal);color:var(--paper)}
    .nav svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;flex:0 0 auto}
    .session-box{border-top:1px solid var(--line);padding-top:20px;margin-top:22px}.session-head{display:flex;justify-content:space-between;align-items:baseline}.session-score{font-family:"Newsreader",serif;font-size:2.3rem;color:var(--accent)}.session-label{font-size:.78rem;color:var(--muted)}
    .meter{height:7px;background:var(--line);margin:9px 0 8px;overflow:hidden}.meter span{display:block;height:100%;width:0;background:var(--accent);transition:width .6s ease}.session-note{font-size:.78rem;color:var(--muted);line-height:1.4;margin:0}

    main{min-width:0}.hero{padding:clamp(28px,5vw,58px);min-height:330px;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:180px;height:180px;border:36px solid var(--accent-soft);border-radius:50%;right:-58px;top:-68px;opacity:.75;pointer-events:none}.hero .intro{max-width:600px;font-size:1.02rem}.primary,.secondary,.text-btn{border:0;cursor:pointer;font-weight:700}.primary{background:var(--accent);color:#fff;padding:13px 20px;border-radius:6px;box-shadow:0 5px 0 var(--accent-strong);transition:transform .16s,box-shadow .16s}.primary:hover{transform:translateY(-2px);box-shadow:0 7px 0 var(--accent-strong)}.primary:active{transform:translateY(3px);box-shadow:0 2px 0 var(--accent-strong)}.secondary{background:transparent;border:1px solid var(--line);padding:12px 18px;border-radius:6px}.secondary:hover{border-color:var(--teal);background:var(--teal-soft)}.text-btn{background:transparent;color:var(--teal);padding:8px 0}.text-btn:hover{text-decoration:underline}.actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
    .exercise-strip{display:grid;grid-template-columns:repeat(3,1fr);margin-top:36px;border-top:1px solid var(--line)}.exercise-mini{padding:20px 18px 18px 0}.exercise-mini:nth-child(3n+2),.exercise-mini:nth-child(3n+3){border-left:1px solid var(--line);padding-left:18px}.exercise-mini:nth-child(n+4){border-top:1px solid var(--line)}.mini-num{font-family:"Newsreader",serif;color:var(--accent);font-size:1.4rem}.exercise-mini p{color:var(--muted);font-size:.82rem;line-height:1.5;margin:4px 0 0}

    .test-panel{padding:clamp(24px,4vw,46px);min-height:590px}.test-top{display:flex;align-items:start;justify-content:space-between;gap:18px;margin-bottom:30px}.step-badge{font-size:.76rem;font-weight:700;color:var(--teal);padding:7px 9px;background:var(--teal-soft);border-radius:4px;white-space:nowrap}.instruction{color:var(--muted);line-height:1.6;max-width:600px}.stage{border-top:1px solid var(--line);padding-top:30px;min-height:340px;display:grid;align-content:center;justify-items:center;text-align:center}.countdown{font-family:"Newsreader",serif;font-size:clamp(3.2rem,9vw,6.5rem);color:var(--accent);line-height:1}.countdown-label{color:var(--muted);margin-top:10px}
    .memory-grid{display:grid;grid-template-columns:repeat(var(--cols,4),minmax(42px,70px));gap:10px;margin:12px auto 26px}.cell{aspect-ratio:1;border:1px solid var(--line);background:var(--bg);border-radius:5px;cursor:pointer;position:relative;display:grid;place-items:center;transition:background .16s,border-color .16s}.cell:hover{border-color:var(--teal)}.cell.lit{background:var(--accent);border-color:var(--accent)}.cell.selected{background:var(--teal);border-color:var(--teal)}.cell.correct{background:var(--success);border-color:var(--success)}.cell.wrong{background:var(--danger);border-color:var(--danger)}
    .digit-display{font-family:"Newsreader",serif;font-variant-numeric:tabular-nums;letter-spacing:.16em;font-size:clamp(2.4rem,8vw,5.7rem);color:var(--teal);margin:34px 0}.answer-input{width:min(420px,100%);font-size:1.75rem;text-align:center;letter-spacing:.15em;background:var(--bg);border:1px solid var(--line);color:var(--ink);padding:14px;border-radius:6px;margin-bottom:18px}.answer-input:focus{outline:3px solid color-mix(in srgb,var(--focus) 28%,transparent);border-color:var(--focus)}
    .shape{width:26px;height:26px;display:block}.circle{border-radius:50%;background:#d25841}.square{background:#e0ad3c}.diamond{background:#24766d;transform:rotate(45deg);width:23px;height:23px}.triangle{width:0;height:0;border-left:14px solid transparent;border-right:14px solid transparent;border-bottom:26px solid #6380a8}.cross{position:relative}.cross:before,.cross:after{content:"";position:absolute;background:#a15d8d;inset:9px 0}.cross:after{inset:0 9px}.target-row{display:flex;align-items:center;gap:12px;margin-bottom:16px;color:var(--muted)}
    .feedback{width:min(520px,100%);padding:22px;text-align:left;background:var(--teal-soft);border-radius:7px;margin-bottom:20px}.feedback strong{display:block;font-family:"Newsreader",serif;font-size:1.55rem;margin-bottom:6px}.feedback p{margin:0;color:var(--muted);line-height:1.5}.feedback.bad{background:var(--accent-soft)}
    .result-score{font-family:"Newsreader",serif;font-size:clamp(4rem,11vw,7rem);color:var(--accent);line-height:.9;margin:15px 0}.result-label{color:var(--teal);font-weight:700;font-size:1.1rem}.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:min(560px,100%);margin:28px auto}.result-item{background:var(--bg);padding:17px 10px}.result-item b{display:block;font-size:1.2rem;color:var(--ink)}.result-item span{color:var(--muted);font-size:.78rem}.recommend{width:min(560px,100%);text-align:left;border-top:1px solid var(--line);padding:20px 0 0;margin-bottom:20px}.recommend p{color:var(--muted);line-height:1.55}
    .notice{font-size:.78rem;color:var(--muted);line-height:1.5;margin:20px 0 0;padding-top:16px;border-top:1px solid var(--line)}
    .choice-grid{display:grid;grid-template-columns:repeat(2,minmax(130px,1fr));gap:10px;width:min(520px,100%);margin:18px auto}.choice{border:1px solid var(--line);background:var(--bg);padding:14px 12px;border-radius:6px;cursor:pointer;font-weight:700}.choice:hover,.choice.selected{background:var(--teal-soft);border-color:var(--teal)}.choice.wrong{background:var(--accent-soft);border-color:var(--accent)}.color-sequence{display:flex;gap:13px;justify-content:center;flex-wrap:wrap;margin:28px 0}.color-dot{width:54px;height:54px;border-radius:50%;border:4px solid var(--paper);box-shadow:0 0 0 1px var(--line)}.color-buttons{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:22px 0}.color-button{width:52px;height:52px;border:3px solid var(--paper);box-shadow:0 0 0 1px var(--line);border-radius:50%;cursor:pointer}.scene-card{display:grid;grid-template-columns:repeat(4,54px);gap:13px;padding:28px;background:var(--bg);border:1px solid var(--line);margin:18px 0}.scene-item{height:54px;display:grid;place-items:center}.pair-grid{display:grid;grid-template-columns:repeat(2,minmax(130px,1fr));gap:10px;width:min(460px,100%);margin:18px auto}.pair-card{display:flex;align-items:center;justify-content:center;gap:16px;padding:18px;background:var(--bg);border:1px solid var(--line);font-size:1.4rem;font-weight:700}.pair-symbol{font-size:2rem;color:var(--teal)}.plan-list{display:grid;gap:9px;width:min(560px,100%);margin:18px auto 24px;text-align:left}.plan-row{display:grid;grid-template-columns:36px 1fr auto;gap:12px;align-items:center;padding:13px 14px;background:var(--bg);border:1px solid var(--line)}.plan-row strong{display:block}.plan-row span{color:var(--muted);font-size:.78rem}.plan-num{font-family:"Newsreader",serif;font-size:1.25rem;color:var(--accent)}.queue-progress{display:flex;gap:5px;min-width:110px}.queue-progress i{height:5px;flex:1;background:var(--line)}.queue-progress i.done{background:var(--teal)}.queue-progress i.current{background:var(--accent)}
    .hidden{display:none!important}
    :focus-visible{outline:3px solid var(--focus);outline-offset:3px}
    .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

    @media(max-width:820px){.shell{padding-top:14px}.utility{margin-bottom:12px}.layout{grid-template-columns:1fr}.panel{box-shadow:none}aside{position:static;padding:18px}.brand{width:min(280px,100%);margin:0 auto 16px}.aside-copy,.session-box{display:none}.nav{display:grid;grid-template-columns:repeat(3,1fr);margin:0;gap:4px}.nav button{justify-content:center;padding:10px 6px;font-size:.72rem;flex-direction:column;gap:5px;text-align:center}.nav svg{width:18px;height:18px}.hero{min-height:0}.exercise-strip{grid-template-columns:1fr;gap:0}.exercise-mini{padding:15px 0!important;border-left:0!important;border-bottom:1px solid var(--line)}.exercise-mini:last-child{border-bottom:0}.test-panel{min-height:560px}.memory-grid{gap:7px;grid-template-columns:repeat(var(--cols,4),minmax(40px,61px))}}
    @media(max-width:430px){.shell{padding-left:12px;padding-right:12px}.nav button{font-size:.65rem}.hero,.test-panel{padding:24px 19px}h1{font-size:2.35rem}.test-top{display:block}.step-badge{display:inline-block;margin-bottom:14px}.result-grid{grid-template-columns:1fr}.result-item{display:flex;justify-content:space-between;align-items:center;text-align:left}.result-item b{order:2}.memory-grid{grid-template-columns:repeat(var(--cols,4),minmax(37px,54px))}.choice-grid{grid-template-columns:1fr}.scene-card{grid-template-columns:repeat(4,45px);gap:7px;padding:16px}.scene-item{height:45px}.pair-grid{grid-template-columns:1fr}.plan-row{grid-template-columns:30px 1fr}.plan-row>span:last-child{grid-column:2}}
    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
    @media print{.utility,aside,.actions,.nav{display:none!important}.shell{padding:0}.layout{display:block}.panel{box-shadow:none;border:0}.hero,.test-panel{padding:18px}.hero:after{display:none}}
  </style>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
<div class="shell">
  <div class="utility"><button class="icon-btn" id="themeToggle" aria-label="Switch color theme" title="Switch color theme"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.4A8.5 8.5 0 0 1 8.6 3.5 8.5 8.5 0 1 0 20.5 15.4Z"/></svg></button></div>
  <div class="layout">
    <aside class="panel" aria-label="Training modes">
      <div class="brand"><img src="data:image/png;base64," alt="Photographic Memory Trainer"></div>
      <div class="aside-copy">
        <p class="eyebrow">Visual recall lab</p>
        <p class="intro">A broader six-skill baseline followed by an adaptive training sequence.</p>
      </div>
      <nav class="nav">
        <button class="active" data-mode="assessment"><svg viewBox="0 0 24 24"><path d="M4 19V9m6 10V5m6 14v-7m4 7H2"/></svg><span>Assessment</span></button>
        <button data-mode="plan"><svg viewBox="0 0 24 24"><path d="M5 6h14M5 12h14M5 18h14"/><circle cx="3" cy="6" r="1"/><circle cx="3" cy="12" r="1"/><circle cx="3" cy="18" r="1"/></svg><span>My plan</span></button>
        <button data-mode="guide"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10h.01"/></svg><span>Guide</span></button>
      </nav>
      <div class="session-box" aria-live="polite">
        <div class="session-head"><div><span class="session-score" id="sessionScore">—</span><span class="session-label"> / 100</span></div><span class="session-label">This session</span></div>
        <div class="meter"><span id="scoreMeter"></span></div>
        <p class="session-note" id="sessionNote">Complete the assessment to map your visual recall.</p>
      </div>
    </aside>

    <main id="main">
      <section class="panel hero" id="hero">
        <p class="eyebrow">Six-part baseline</p>
        <h1>How sharp is your visual recall?</h1>
        <p class="intro">Test six distinct memory skills, then follow a drill sequence chosen from your weakest results. Perfect attempts automatically raise the next drill’s difficulty.</p>
        <div class="actions"><button class="primary" id="startAssessment">Start the assessment</button><button class="text-btn" id="howItWorks">How scoring works</button></div>
        <div class="exercise-strip" aria-label="Assessment exercises">
          <div class="exercise-mini"><span class="mini-num">01</span><h3>Pattern recall</h3><p>Remember highlighted cells, then rebuild the grid.</p></div>
          <div class="exercise-mini"><span class="mini-num">02</span><h3>Sequence hold</h3><p>Retain a number string after it disappears.</p></div>
          <div class="exercise-mini"><span class="mini-num">03</span><h3>Spatial placement</h3><p>Track one visual mark among several positions.</p></div>
          <div class="exercise-mini"><span class="mini-num">04</span><h3>Color order</h3><p>Rebuild a short chain of colors in sequence.</p></div>
          <div class="exercise-mini"><span class="mini-num">05</span><h3>Detail scan</h3><p>Study a visual scene and answer one precise question.</p></div>
          <div class="exercise-mini"><span class="mini-num">06</span><h3>Associations</h3><p>Recall which number belonged to a visual symbol.</p></div>
        </div>
        <p class="notice">This is a practical visual-memory exercise, not a medical or cognitive diagnosis. “Photographic memory” is not a standardized clinical ability.</p>
      </section>

      <section class="panel test-panel hidden" id="testPanel" aria-live="polite">
        <div id="testContent"></div>
      </section>
    </main>
  </div>
</div>

<script>
(function(){
  var MODES=['pattern','sequence','position','color','detail','association'];
  var LABELS={pattern:'Pattern',sequence:'Sequence',position:'Position',color:'Color order',detail:'Detail scan',association:'Associations'};
  var state={mode:'assessment',round:0,scores:[],phase:'idle',timer:null,levels:{pattern:1,sequence:1,position:1,color:1,detail:1,association:1},plan:[],planIndex:0,planScores:[]};
  var hero=document.getElementById('hero'),panel=document.getElementById('testPanel'),content=document.getElementById('testContent');
  var sessionScore=document.getElementById('sessionScore'),scoreMeter=document.getElementById('scoreMeter'),sessionNote=document.getElementById('sessionNote');
  var COLORS=[{name:'coral',hex:'#c8553d'},{name:'teal',hex:'#24766d'},{name:'gold',hex:'#d2a43b'},{name:'blue',hex:'#6380a8'},{name:'violet',hex:'#9a6089'}];

  function clearTimer(){if(state.timer){clearInterval(state.timer);clearTimeout(state.timer);state.timer=null}}
  function randomUnique(count,max){var s=[];while(s.length<count){var n=Math.floor(Math.random()*max);if(s.indexOf(n)<0)s.push(n)}return s}
  function shuffled(arr){var out=arr.slice();for(var i=out.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=out[i];out[i]=out[j];out[j]=t}return out}
  function showPanel(){hero.classList.add('hidden');panel.classList.remove('hidden');window.scrollTo({top:0,behavior:'smooth'})}
  function showHero(){clearTimer();panel.classList.add('hidden');hero.classList.remove('hidden');setNav('assessment');window.scrollTo({top:0,behavior:'smooth'})}
  function setNav(mode){document.querySelectorAll('.nav button').forEach(function(b){b.classList.toggle('active',b.dataset.mode===mode)})}
  function updateSession(score,note){sessionScore.textContent=Math.round(score);scoreMeter.style.width=Math.max(0,Math.min(100,score))+'%';sessionNote.textContent=note}
  function countdown(label,seconds,done){showPanel();content.innerHTML='<div class="test-top"><div><p class="eyebrow">Get ready</p><h2>'+label+'</h2></div></div><div class="stage"><div><div class="countdown" id="countNum">'+seconds+'</div><p class="countdown-label">Focus your attention</p></div></div>';var n=seconds;state.timer=setInterval(function(){n--;var el=document.getElementById('countNum');if(el)el.textContent=n||'Go';if(n<=0){clearTimer();setTimeout(done,350)}},700)}
  function header(title,desc,badge){return '<div class="test-top"><div><p class="eyebrow">Visual recall exercise</p><h2>'+title+'</h2><p class="instruction">'+desc+'</p></div><span class="step-badge">'+badge+'</span></div>'}
  function levelFor(mode){return state.levels[mode]||1}
  function advanceDifficulty(mode,score){if(score===100){state.levels[mode]=levelFor(mode)+1;return true}return false}
  function assessmentBadge(mode){return 'Exercise '+(state.round+1)+' of '+MODES.length+' · Level '+levelFor(mode)}
  function practiceBadge(mode){return 'Plan drill '+(state.planIndex+1)+' of '+state.plan.length+' · Level '+levelFor(mode)}
  function cap(s){return s.charAt(0).toUpperCase()+s.slice(1)}
  function strength(s){return s>=85?'Exceptional':s>=70?'Strong':s>=45?'Developing':'Early-stage'}

  function startAssessment(){clearTimer();state.mode='assessment';state.round=0;state.scores=[];state.plan=[];state.planScores=[];setNav('assessment');countdown('Six-skill baseline',3,runAssessmentRound)}
  function runAssessmentRound(){runMode(MODES[state.round],false)}
  function runMode(mode,practice){if(mode==='pattern')runPattern(practice);if(mode==='sequence')runSequence(practice);if(mode==='position')runPosition(practice);if(mode==='color')runColor(practice);if(mode==='detail')runDetail(practice);if(mode==='association')runAssociation(practice)}
  function complete(score,mode,message){if(state.mode==='assessment')finishRound(score,mode,message);else finishPractice(score,mode,message)}

  function finishRound(score,mode,message){var completedLevel=levelFor(mode),advanced=advanceDifficulty(mode,score),last=state.round===MODES.length-1;state.scores.push(Math.round(score));content.innerHTML=header(last?'Baseline complete':'Exercise complete',message,'Level '+completedLevel+' · Score '+Math.round(score)+'/100')+'<div class="stage"><div class="feedback '+(score<60?'bad':'')+'"><strong>'+(score>=85?'Excellent recall':score>=65?'Solid work':score>=40?'A useful baseline':'Training target found')+'</strong><p>'+feedbackText(mode,score)+(advanced?' You unlocked level '+levelFor(mode)+' for '+LABELS[mode].toLowerCase()+'.':'')+'</p></div><button class="primary" id="nextRound">'+(last?'Build my training sequence':'Continue to exercise '+(state.round+2))+'</button></div>';document.getElementById('nextRound').onclick=function(){if(last)showResults();else{state.round++;runAssessmentRound()}}}
  function feedbackText(mode,score){if(score>=85)return 'Your '+LABELS[mode].toLowerCase()+' recall was highly accurate.';if(score>=60)return 'Your '+LABELS[mode].toLowerCase()+' result is solid, with room to sharpen.';return 'This result marks '+LABELS[mode].toLowerCase()+' as a useful focus for adaptive practice.'}

  function buildPlan(){var ranked=MODES.map(function(m,i){return {mode:m,score:state.scores[i]}}).sort(function(a,b){return a.score-b.score});state.plan=[ranked[0].mode,ranked[1].mode,ranked[2].mode,ranked[0].mode,ranked[1].mode,ranked[0].mode];return ranked}
  function showResults(){var total=Math.round(state.scores.reduce(function(a,b){return a+b},0)/state.scores.length),ranked=buildPlan();updateSession(total,strength(total)+' recall · adaptive plan ready.');setNav('plan');content.innerHTML=header('Your adaptive training sequence','The next six drills are selected automatically from the three areas with the most room to improve.','Assessment complete')+'<div class="stage"><div class="result-score">'+total+'</div><div class="result-label">'+strength(total)+' visual recall</div><div class="result-grid">'+state.scores.map(function(s,i){return '<div class="result-item"><b>'+s+'</b><span>'+LABELS[MODES[i]]+'</span></div>'}).join('')+'</div><div class="recommend"><h3>Priority: '+LABELS[ranked[0].mode]+'</h3><p>'+recommendation(ranked[0].mode)+'</p></div>'+planMarkup()+'<div class="actions"><button class="primary" id="startPlan">Start adaptive training</button><button class="secondary" id="retry">Retake assessment</button></div></div>';document.getElementById('startPlan').onclick=startAdaptivePlan;document.getElementById('retry').onclick=startAssessment}
  function planMarkup(){return '<div class="plan-list" aria-label="Adaptive drill sequence">'+state.plan.map(function(m,i){return '<div class="plan-row"><b class="plan-num">'+String(i+1).padStart(2,'0')+'</b><div><strong>'+LABELS[m]+'</strong><span>'+recommendation(m)+'</span></div><span>Level '+levelFor(m)+'</span></div>'}).join('')+'</div>'}
  function recommendation(mode){if(mode==='pattern')return 'Read groups, outlines, and symmetry.';if(mode==='sequence')return 'Chunk digits into pairs before recall.';if(mode==='position')return 'Use the center and corners as anchors.';if(mode==='color')return 'Name colors in rhythm as you scan.';if(mode==='detail')return 'Scan once by type, then by quantity.';return 'Link each symbol and number as one image.'}
  function startAdaptivePlan(){state.mode='plan';state.planIndex=0;state.planScores=[];setNav('plan');countdown('Adaptive training',3,runPlanDrill)}
  function runPlanDrill(){runMode(state.plan[state.planIndex],true)}
  function finishPractice(score,mode,message){var completedLevel=levelFor(mode),advanced=advanceDifficulty(mode,score);state.planScores.push(Math.round(score));var last=state.planIndex===state.plan.length-1;updateSession(score,'Latest '+LABELS[mode].toLowerCase()+' drill score.');content.innerHTML=header(last?'Training sequence complete':LABELS[mode]+' drill complete',message,'Level '+completedLevel+' · Score '+Math.round(score)+'/100')+'<div class="stage"><div class="result-score">'+Math.round(score)+'</div><div class="result-label">'+strength(score)+'</div><p class="countdown-label">'+(advanced?'Perfect recall unlocked level '+levelFor(mode)+'.':'The next perfect attempt unlocks a harder level.')+'</p><div class="queue-progress" aria-label="Training sequence progress">'+state.plan.map(function(_,i){return '<i class="'+(i<state.planIndex?'done':i===state.planIndex?'current':'')+'"></i>'}).join('')+'</div><div class="actions" style="margin-top:30px;justify-content:center"><button class="primary" id="continuePlan">'+(last?'See session summary':'Continue to drill '+(state.planIndex+2))+'</button><button class="secondary" id="restartAssessment">New assessment</button></div></div>';document.getElementById('continuePlan').onclick=function(){if(last)showPlanSummary();else{state.planIndex++;countdown(LABELS[state.plan[state.planIndex]]+' drill',2,runPlanDrill)}};document.getElementById('restartAssessment').onclick=startAssessment}
  function showPlanSummary(){var average=Math.round(state.planScores.reduce(function(a,b){return a+b},0)/state.planScores.length);updateSession(average,'Adaptive sequence complete.');content.innerHTML=header('Training sequence complete','You finished all six automatically selected drills.','Session summary')+'<div class="stage"><div class="result-score">'+average+'</div><div class="result-label">Average drill score</div><div class="result-grid">'+state.planScores.map(function(s,i){return '<div class="result-item"><b>'+s+'</b><span>'+LABELS[state.plan[i]]+'</span></div>'}).join('')+'</div><div class="actions"><button class="primary" id="again">Run this plan again</button><button class="secondary" id="reassess">Reassess all six skills</button></div></div>';document.getElementById('again').onclick=startAdaptivePlan;document.getElementById('reassess').onclick=startAssessment}

  function runPattern(practice){var mode='pattern',level=levelFor(mode),cols=Math.min(7,(practice?5:4)+Math.floor((level-1)/3)),rows=4+Math.floor((level-1)/2),size=cols*rows,required=Math.min(size-1,(practice?7:5)+(level-1)*2),seconds=Math.max(2,4-Math.floor((level-1)/3)),lit=randomUnique(required,size);state.pattern={lit:lit,selected:[],size:size,cols:cols,required:required,practice:practice,level:level};content.innerHTML=header('Memorize the pattern','Study the '+required+' highlighted cells. They disappear in <span id="seconds">'+seconds+'</span> seconds.',practice?practiceBadge(mode):assessmentBadge(mode))+'<div class="stage"><div class="memory-grid" style="--cols:'+cols+'">'+cells(size,function(i){return 'cell '+(lit.indexOf(i)>=0?'lit':'')})+'</div><p class="countdown-label">Look for the overall shape, not each cell separately.</p></div>';timedHide(seconds,patternRecall)}
  function patternRecall(){var p=state.pattern;content.innerHTML=header('Rebuild the pattern','Select the '+p.required+' cells that were highlighted, then check your answer.',p.practice?practiceBadge('pattern'):assessmentBadge('pattern'))+'<div class="stage"><div class="memory-grid" id="patternGrid" style="--cols:'+p.cols+'">'+cells(p.size,function(){return 'cell'})+'</div><button class="primary" id="checkPattern" disabled>Check pattern</button><p class="countdown-label" id="selectedCount">0 of '+p.required+' selected</p></div>';var grid=document.getElementById('patternGrid'),check=document.getElementById('checkPattern');grid.querySelectorAll('.cell').forEach(function(c){c.onclick=function(){var i=Number(c.dataset.i),at=p.selected.indexOf(i);if(at>=0){p.selected.splice(at,1);c.classList.remove('selected')}else if(p.selected.length<p.required){p.selected.push(i);c.classList.add('selected')}document.getElementById('selectedCount').textContent=p.selected.length+' of '+p.required+' selected';check.disabled=p.selected.length!==p.required}});check.onclick=function(){var hits=p.selected.filter(function(i){return p.lit.indexOf(i)>=0}).length,score=Math.round(hits/p.required*100);p.selected.forEach(function(i){grid.children[i].classList.add(p.lit.indexOf(i)>=0?'correct':'wrong')});p.lit.forEach(function(i){if(p.selected.indexOf(i)<0)grid.children[i].classList.add('lit')});setTimeout(function(){complete(score,'pattern','You recalled '+hits+' of '+p.required+' target cells.')},650)}}

  function runSequence(practice){var mode='sequence',level=levelFor(mode),len=(practice?9:8)+(level-1),seconds=Math.max(2,4-Math.floor((level-1)/4)),digits='';for(var i=0;i<len;i++)digits+=Math.floor(Math.random()*10);state.sequence={digits:digits,practice:practice,level:level};content.innerHTML=header('Hold the sequence','Memorize all '+len+' digits in order. They disappear in <span id="seconds">'+seconds+'</span> seconds.',practice?practiceBadge(mode):assessmentBadge(mode))+'<div class="stage"><div class="digit-display">'+digits+'</div><p class="countdown-label">Try grouping the digits into pairs.</p></div>';timedHide(seconds,sequenceRecall)}
  function sequenceRecall(){var s=state.sequence;content.innerHTML=header('Enter the sequence','Type the digits exactly as you saw them.',s.practice?practiceBadge('sequence'):assessmentBadge('sequence'))+'<div class="stage"><label class="sr-only" for="digitAnswer">Remembered digits</label><input class="answer-input" id="digitAnswer" inputmode="numeric" maxlength="'+s.digits.length+'" autocomplete="off" placeholder="'+Array(s.digits.length+1).join('•')+'"><button class="primary" id="checkDigits">Check sequence</button></div>';var input=document.getElementById('digitAnswer');input.focus();input.oninput=function(){input.value=input.value.replace(/\D/g,'')};document.getElementById('checkDigits').onclick=function(){var answer=input.value,hits=0;for(var i=0;i<s.digits.length;i++)if(answer[i]===s.digits[i])hits++;complete(Math.round(hits/s.digits.length*100),'sequence','You placed '+hits+' of '+s.digits.length+' digits correctly. The sequence was '+s.digits+'.')}}

  function runPosition(practice){var mode='position',level=levelFor(mode),names=['red circle','gold square','teal diamond','blue triangle','violet cross'],classes=['circle','square','diamond','triangle','cross'],size=9+(level-1)*3,cols=Math.min(7,Math.ceil(Math.sqrt(size))),seconds=Math.max(2,5-Math.floor((level-1)/4)),positions=randomUnique(5,size),target=Math.floor(Math.random()*5);state.position={positions:positions,target:target,names:names,classes:classes,practice:practice,size:size,cols:cols,level:level};content.innerHTML=header('Map the positions','Remember where each symbol sits. They disappear in <span id="seconds">'+seconds+'</span> seconds.',practice?practiceBadge(mode):assessmentBadge(mode))+'<div class="stage"><div class="memory-grid" style="--cols:'+cols+'">'+cells(size,function(){return 'cell'},function(i){var x=positions.indexOf(i);return x>=0?'<span class="shape '+classes[x]+'"></span>':''})+'</div><p class="countdown-label">Notice each symbol’s relation to the center.</p></div>';timedHide(seconds,positionRecall)}
  function positionRecall(){var p=state.position;content.innerHTML=header('Place the symbol','Select the cell where this symbol appeared.',p.practice?practiceBadge('position'):assessmentBadge('position'))+'<div class="stage"><div class="target-row"><span>Find the</span><span class="shape '+p.classes[p.target]+'"></span><strong>'+p.names[p.target]+'</strong></div><div class="memory-grid" id="positionGrid" style="--cols:'+p.cols+'">'+cells(p.size,function(){return 'cell'})+'</div></div>';var grid=document.getElementById('positionGrid');grid.querySelectorAll('.cell').forEach(function(c){c.onclick=function(){grid.querySelectorAll('.cell').forEach(function(x){x.disabled=true});var chosen=Number(c.dataset.i),correct=p.positions[p.target],score=chosen===correct?100:0;c.classList.add(chosen===correct?'correct':'wrong');grid.children[correct].classList.add('correct');setTimeout(function(){complete(score,'position',score?'You placed the target symbol correctly.':'The correct position is shown in green.')},650)}})}

  function runColor(practice){var mode='color',level=levelFor(mode),len=(practice?6:5)+Math.floor((level-1)/2),seconds=Math.max(2,5-Math.floor((level-1)/3)),sequence=[];for(var i=0;i<len;i++)sequence.push(Math.floor(Math.random()*COLORS.length));state.color={sequence:sequence,answer:[],practice:practice,level:level};content.innerHTML=header('Memorize the color order','Read the colors from left to right. They disappear in <span id="seconds">'+seconds+'</span> seconds.',practice?practiceBadge(mode):assessmentBadge(mode))+'<div class="stage"><div class="color-sequence">'+sequence.map(function(x){return '<span class="color-dot" style="background:'+COLORS[x].hex+'" title="'+COLORS[x].name+'"></span>'}).join('')+'</div><p class="countdown-label">Name the colors in a steady rhythm.</p></div>';timedHide(seconds,colorRecall)}
  function colorRecall(){var c=state.color;content.innerHTML=header('Rebuild the color order','Tap colors in the order you saw them.',c.practice?practiceBadge('color'):assessmentBadge('color'))+'<div class="stage"><div class="color-sequence" id="colorAnswer"></div><div class="color-buttons">'+COLORS.map(function(x,i){return '<button class="color-button" data-i="'+i+'" style="background:'+x.hex+'" aria-label="'+x.name+'"></button>'}).join('')+'</div><button class="primary" id="checkColors" disabled>Check order</button><button class="text-btn" id="clearColors">Clear answer</button><p class="countdown-label" id="colorCount">0 of '+c.sequence.length+' selected</p></div>';var answer=document.getElementById('colorAnswer'),check=document.getElementById('checkColors');function draw(){answer.innerHTML=c.answer.map(function(x){return '<span class="color-dot" style="background:'+COLORS[x].hex+'"></span>'}).join('');document.getElementById('colorCount').textContent=c.answer.length+' of '+c.sequence.length+' selected';check.disabled=c.answer.length!==c.sequence.length}document.querySelectorAll('.color-button').forEach(function(b){b.onclick=function(){if(c.answer.length<c.sequence.length){c.answer.push(Number(b.dataset.i));draw()}}});document.getElementById('clearColors').onclick=function(){c.answer=[];draw()};check.onclick=function(){var hits=0;for(var i=0;i<c.sequence.length;i++)if(c.answer[i]===c.sequence[i])hits++;complete(Math.round(hits/c.sequence.length*100),'color','You placed '+hits+' of '+c.sequence.length+' colors in the correct position.')}}

  function runDetail(practice){var mode='detail',level=levelFor(mode),count=(practice?10:8)+Math.min(6,level-1),classes=['circle','square','diamond','triangle'],items=[],target=Math.floor(Math.random()*classes.length),seconds=Math.max(3,6-Math.floor((level-1)/3));for(var i=0;i<count;i++)items.push(Math.floor(Math.random()*classes.length));if(items.indexOf(target)<0)items[0]=target;state.detail={items:items,target:target,classes:classes,practice:practice,level:level};content.innerHTML=header('Scan the scene','Study the symbols and their quantities. The scene disappears in <span id="seconds">'+seconds+'</span> seconds.',practice?practiceBadge(mode):assessmentBadge(mode))+'<div class="stage"><div class="scene-card">'+items.map(function(x){return '<span class="scene-item"><i class="shape '+classes[x]+'"></i></span>'}).join('')+'</div><p class="countdown-label">Scan once by shape, then once by count.</p></div>';timedHide(seconds,detailRecall)}
  function detailRecall(){var d=state.detail,correct=d.items.filter(function(x){return x===d.target}).length,options=shuffled([correct,Math.max(0,correct-1),correct+1,correct+2].filter(function(v,i,a){return a.indexOf(v)===i}));while(options.length<4){var n=Math.floor(Math.random()*d.items.length)+1;if(options.indexOf(n)<0)options.push(n)}content.innerHTML=header('Recall one detail','How many of this symbol were in the scene?',d.practice?practiceBadge('detail'):assessmentBadge('detail'))+'<div class="stage"><span class="shape '+d.classes[d.target]+'" style="margin-bottom:18px"></span><div class="choice-grid">'+options.map(function(x){return '<button class="choice" data-value="'+x+'">'+x+'</button>'}).join('')+'</div></div>';document.querySelectorAll('.choice').forEach(function(b){b.onclick=function(){document.querySelectorAll('.choice').forEach(function(x){x.disabled=true});var answer=Number(b.dataset.value),score=answer===correct?100:0;b.classList.add(answer===correct?'selected':'wrong');setTimeout(function(){complete(score,'detail',score?'You counted the detail correctly.':'The scene contained '+correct+' matching symbols.')},450)}})}

  function runAssociation(practice){var mode='association',level=levelFor(mode),symbols=['◆','●','▲','■','✚','⬟'],count=Math.min(6,(practice?5:4)+Math.floor((level-1)/2)),nums=randomUnique(count,10),target=Math.floor(Math.random()*count),seconds=Math.max(3,6-Math.floor((level-1)/3));state.association={symbols:symbols.slice(0,count),nums:nums,target:target,practice:practice,level:level};content.innerHTML=header('Link each pair','Memorize every symbol and its number. The pairs disappear in <span id="seconds">'+seconds+'</span> seconds.',practice?practiceBadge(mode):assessmentBadge(mode))+'<div class="stage"><div class="pair-grid">'+state.association.symbols.map(function(s,i){return '<div class="pair-card"><span class="pair-symbol">'+s+'</span><span>'+nums[i]+'</span></div>'}).join('')+'</div><p class="countdown-label">Imagine the symbol and number as one object.</p></div>';timedHide(seconds,associationRecall)}
  function associationRecall(){var a=state.association,correct=a.nums[a.target],options=shuffled(a.nums.slice()),answered=false;content.innerHTML=header('Recall the pair','Which number belonged to this symbol?',a.practice?practiceBadge('association'):assessmentBadge('association'))+'<div class="stage"><div class="pair-symbol" style="font-size:4rem">'+a.symbols[a.target]+'</div><div class="choice-grid">'+options.map(function(x){return '<button class="choice" data-value="'+x+'">'+x+'</button>'}).join('')+'</div></div>';document.querySelectorAll('.choice').forEach(function(b){b.onclick=function(){if(answered)return;answered=true;document.querySelectorAll('.choice').forEach(function(x){x.disabled=true});var answer=Number(b.dataset.value),score=answer===correct?100:0;b.classList.add('selected');complete(score,'association',score?'You recalled the association correctly.':'The correct pair was '+a.symbols[a.target]+' and '+correct+'.')}})}

  function timedHide(seconds,done){var n=seconds;state.timer=setInterval(function(){n--;var el=document.getElementById('seconds');if(el)el.textContent=n;if(n<=0){clearTimer();done()}},1000)}
  function cells(n,classFn,htmlFn){var out='';for(var i=0;i<n;i++)out+='<button type="button" class="'+classFn(i)+'" data-i="'+i+'" aria-label="Grid cell '+(i+1)+'">'+(htmlFn?htmlFn(i):'')+'</button>';return out}

  function showGuide(){clearTimer();showPanel();setNav('guide');content.innerHTML=header('How the trainer adapts','The assessment maps six skills. Your training sequence is then built from the lowest three scores, so you do not have to choose a drill.','Training guide')+'<div class="stage" style="text-align:left;justify-items:stretch;max-width:650px;margin:auto"><div class="feedback"><strong>Six-part baseline</strong><p>Pattern, digit sequence, spatial position, color order, detail scanning, and visual associations each produce a score from 0 to 100.</p></div><div class="feedback"><strong>Automatic sequence</strong><p>Your weakest area appears three times, the next appears twice, and the third appears once in a six-drill session.</p></div><div class="feedback"><strong>Progressive difficulty</strong><p>A perfect attempt raises that drill’s level by adding more information, more possible positions, or less study time.</p></div><button class="primary" id="guideStart" style="justify-self:start">Start assessment</button></div>';document.getElementById('guideStart').onclick=startAssessment}
  function showSavedPlan(){if(state.plan.length){showResults()}else{showPanel();setNav('plan');content.innerHTML=header('Your plan starts with a baseline','Complete the six-part assessment so the trainer can choose the right drill sequence.','No plan yet')+'<div class="stage"><div class="feedback"><strong>No guessing required</strong><p>Your lowest three skill scores determine the sequence automatically.</p></div><button class="primary" id="planAssessment">Take the assessment</button></div>';document.getElementById('planAssessment').onclick=startAssessment}}

  document.getElementById('startAssessment').onclick=startAssessment;
  document.getElementById('howItWorks').onclick=showGuide;
  document.querySelectorAll('.nav button').forEach(function(b){b.onclick=function(){var mode=b.dataset.mode;if(mode==='assessment')showHero();if(mode==='plan')showSavedPlan();if(mode==='guide')showGuide()}});
  document.getElementById('themeToggle').onclick=function(){var current=document.documentElement.getAttribute('data-theme');if(!current)current=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',current==='dark'?'light':'dark')};
})();
</script>
</body>
</html>